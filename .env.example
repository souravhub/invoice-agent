# Copy this file to .env and fill in your own values. Never commit .env.
AI_PROVIDER=gemini                      # which AI to use: openai or gemini (openai if left out)
AI_MODEL=gemini-3-flash-preview         # model name; this is the model the baseline report used
OPENAI_API_KEY=your-openai-api-key-here # only needed when AI_PROVIDER=openai (from platform.openai.com)
GEMINI_API_KEY=your-gemini-api-key-here # only needed when AI_PROVIDER=gemini (from aistudio.google.com)
