# Copy this file to backend/.env.local. Never commit .env.local.
# Values here override backend/.env.

# Gmail Connect: OAuth client for a "Web application" from Google Cloud Console
# (APIs & Services > Credentials). Enable the Gmail API and add the
# https://www.googleapis.com/auth/gmail.readonly scope on the consent screen.
GOOGLE_CLIENT_ID=replace-with-your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-your-client-secret

# Must exactly match an authorized redirect URI on the OAuth client.
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Encrypts Gmail refresh tokens before they are stored in Firestore and signs
# the OAuth state. Changing it disconnects every user. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GMAIL_TOKEN_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Where the browser is sent after Google sign-in finishes.
FRONTEND_URL=http://localhost:3000

# Newest matching emails to inspect per search (1-50).
GMAIL_MAX_MESSAGES=25

# Attachments larger than this are refused (capped at 25 MB).
GMAIL_MAX_ATTACHMENT_BYTES=20971520

# Folder where fetched invoice attachments are saved, one subfolder per user.
# Their details (sender, subject, file name, size) are stored in Firestore at
# users/{uid}/gmailInvoices. Leave empty for backend/storage/gmail-invoices.
GMAIL_STORAGE_DIR=
