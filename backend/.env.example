# Copy this file to backend/.env. Never commit real keys.
# Gmail Connect secrets go in backend/.env.local (see .env.local.example).
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=replace-with-your-openai-api-key
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# Firebase Admin: use a service-account JSON file on the backend only.
# You may set GOOGLE_APPLICATION_CREDENTIALS instead of FIREBASE_SERVICE_ACCOUNT_PATH.
FIREBASE_SERVICE_ACCOUNT_PATH=C:/path/to/firebase-service-account.json
FIREBASE_PROJECT_ID=ai-invoice-d6b8a
