rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // All application data access goes through FastAPI and Firebase Admin.
    // Admin SDK requests bypass these client rules after the API verifies the
    // caller's Firebase ID token and scopes records to that user's UID.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
